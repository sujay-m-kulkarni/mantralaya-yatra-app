<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon: Android masks these 108dp layers to the phone's icon shape. The diya in the
     foreground already sits inside the safe circle (ui/assets), so no inset is added here.
     The monochrome layer is used for Android 13+ themed icons; only its shape matters. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
